{
  "name": "@flyway/ai-service",
  "private": true,
  "version": "1.0.0",
  "description": "Flyway AI itinerary microservice with offline fallback engine (puerto 4001)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --minify --outfile=dist/index.cjs",
    "start": "node --max-old-space-size=128 dist/index.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/aiPlanner.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
