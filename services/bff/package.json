{
  "name": "@flyway/bff",
  "private": true,
  "version": "1.0.0",
  "description": "Flyway API Gateway / Backend-for-Frontend (puerto 4000)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --minify --outfile=dist/index.cjs",
    "start": "node --max-old-space-size=96 dist/index.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/server.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
