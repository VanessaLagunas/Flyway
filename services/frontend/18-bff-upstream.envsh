#!/bin/sh
# Resuelve dinámicamente el upstream del BFF tanto en Kubernetes (GKE) como en Docker Compose

if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
  NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)
  NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS% }"
  export NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS:-127.0.0.11}"
fi

if [ -z "${BFF_UPSTREAM:-}" ]; then
  if [ -n "${BFF_SERVICE_SERVICE_HOST:-}" ]; then
    BFF_UPSTREAM="http://${BFF_SERVICE_SERVICE_HOST}:${BFF_SERVICE_SERVICE_PORT:-4000}"
  elif [ -f /var/run/secrets/kubernetes.io/serviceaccount/namespace ]; then
    K8S_NS=$(tr -d '[:space:]' < /var/run/secrets/kubernetes.io/serviceaccount/namespace)
    BFF_UPSTREAM="http://bff-service.${K8S_NS}.svc.cluster.local:4000"
  else
    BFF_UPSTREAM="http://bff-service:4000"
  fi
fi

BFF_UPSTREAM="${BFF_UPSTREAM%/}"
export BFF_UPSTREAM
