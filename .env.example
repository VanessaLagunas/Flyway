# ====================================================================
# Flyway - Microservices Architecture (6 Contenedores) Environment Variables
# ====================================================================
# Copia este archivo a `.env` para desarrollo local o configuración de Docker Compose:
#   cp .env.example .env

# --------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL - Puerto 5432)
# --------------------------------------------------------------------
POSTGRES_USER=flyway
POSTGRES_PASSWORD=flyway_pass
POSTGRES_DB=flyway_db
POSTGRES_PORT=5432

# URL de conexión para auth-service y catalog-service:
# - En Docker Compose: postgres://flyway:flyway_pass@postgres-db:5432/flyway_db
# - En desarrollo local (Host): postgres://flyway:flyway_pass@localhost:5432/flyway_db
DATABASE_URL=postgres://flyway:flyway_pass@postgres-db:5432/flyway_db

# --------------------------------------------------------------------
# 2. Frontend (React 19 + Vite 8 + Tailwind v4 -> Nginx Puerto 3000:80)
# --------------------------------------------------------------------
VITE_BFF_URL=http://localhost:4000/api/v1
VITE_GOOGLE_CLIENT_ID=

# --------------------------------------------------------------------
# 3. BFF - API Gateway (Express - Puerto 4000)
# --------------------------------------------------------------------
BFF_PORT=4000
NODE_ENV=development

# URLs de los microservicios internos enrutados por el BFF
# - En Docker Compose (red interna flyway-net):
AUTH_SERVICE_URL=http://auth-service:4003
AI_SERVICE_URL=http://ai-service:4001
CATALOG_SERVICE_URL=http://catalog-service:4002
# - Para ejecución local sin Docker descomentar:
# AUTH_SERVICE_URL=http://localhost:4003
# AI_SERVICE_URL=http://localhost:4001
# CATALOG_SERVICE_URL=http://localhost:4002

# --------------------------------------------------------------------
# 4. Auth Service (Express + JWT + Bcrypt.js + Google OAuth - Puerto 4003)
# --------------------------------------------------------------------
AUTH_SERVICE_PORT=4003
JWT_SECRET=flyway-super-secret-jwt-key-2026
GOOGLE_CLIENT_ID=

# --------------------------------------------------------------------
# 5. AI Service (Express - Puerto 4001)
# --------------------------------------------------------------------
AI_SERVICE_PORT=4001
# Modelos de IA activos (separados por coma: gemini, openai, openrouter)
# Permite activar o desactivar modelos específicos según tus necesidades:
ACTIVE_AI_MODELS=gemini,openai,openrouter
# Modo Offline (false en la nube de GCP para garantizar generación real con IA)
ENABLE_OFFLINE_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=180000
AI_SERVICE_TIMEOUT_MS=210000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# 6. Catalog Service (Express - Puerto 4002)
# --------------------------------------------------------------------
CATALOG_SERVICE_PORT=4002
PEXELS_API_KEY=

# --------------------------------------------------------------------
# 7. Producción Local / Docker Compose (docker-compose.prod.yml)
# --------------------------------------------------------------------
GHCR_OWNER=owner

# --------------------------------------------------------------------
# 8. Producción en GCP / Google Kubernetes Engine (GKE) & GitHub Actions
# --------------------------------------------------------------------
# Configurar estos valores como Secrets/Variables en GitHub (Settings > Secrets and variables > Actions):
# - GCP_SA_KEY: Contenido JSON de la Service Account de GCP con roles 'Kubernetes Engine Developer' o 'Admin'
# - GKE_CLUSTER_NAME: Nombre de tu clúster de GKE (ej: flyway-cluster)
# - GKE_REGION: Región de GCP del clúster (ej: us-central1 o us-central1-a)
# - GCP_PROJECT_ID: ID del proyecto en Google Cloud
